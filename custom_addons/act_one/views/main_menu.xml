<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_registration_search" model="ir.ui.view">
            <field name="name">registration.search</field>
            <field name="model">registration</field>
            <field name="arch" type="xml">
                <search string="Search Registrations">
                    <field name="trainee_id"/>
                    <field name="course_id"/>
                </search>
            </field>
        </record>

        <record id="view_course_search" model="ir.ui.view">
            <field name="name">course.search</field>
            <field name="model">course</field>
            <field name="arch" type="xml">
                <search string="Search Courses">
                    <field name="name" string="Course Title"/>
                    <field name="description"/>
                    
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <filter string="All Courses" name="all_course" domain="['|', ('active', '=', True), ('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="view_location_search" model="ir.ui.view">
            <field name="name">location.search</field>
            <field name="model">location</field>
            <field name="arch" type="xml">
                <search string="Search Locations">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record id="view_room_search" model="ir.ui.view">
            <field name="name">room.search</field>
            <field name="model">room</field>
            <field name="arch" type="xml">
                <search string="Search Rooms">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record id="view_teacher_search" model="ir.ui.view">
            <field name="name">teacher.search</field>
            <field name="model">teacher</field>
            <field name="arch" type="xml">
                <search string="Search Teachers">
                    <field name="name"/>
                </search>
            </field>
        </record>


        <record id="view_registration_list" model="ir.ui.view">
            <field name="name">registration.list</field>
            <field name="model">registration</field>
            <field name="arch" type="xml">
            <list string="Registrations">
                <field name="trainee_id"/>
                <field name="course_id"/>
                <field name="course_description"/>
                <field name="teacher_id"/> 
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="number_of_days"/>
                <field name="time" widget="float_time"/>
                <field name="room_id"/>
                <field name="location_id"/>
            </list>
            </field>
        </record>

        <record id="view_registration_form" model="ir.ui.view">
            <field name="name">registration.form</field>
            <field name="model">registration</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'teacher'"/>
                        <button name="action_reject" string="Reject" type="object" class="btn-secondary" invisible="state != 'teacher'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,teacher,approved,rejected"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="trainee_id"/>
                            <field name="course_id"/>
                            <field name="course_description"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="number_of_days"/>
                            <field name="time" widget="float_time"/>
                            <field name="room_id"/>
                            <field name="location_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_course_list" model="ir.ui.view">
            <field name="name">course.list</field>
            <field name="model">course</field>
            <field name="arch" type="xml">
            <list string="Courses">
                <field name="name"/>
                <field name="description"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="number_of_days"/>
                <field name="time" widget="float_time"/>
                <field name="available_seats"/>
                <field name="target_gender"/>
                <field name="deadline"/>
            </list>
            </field>
        </record>

        <record id="view_course_form" model="ir.ui.view">
            <field name="name">course.form</field>
            <field name="model">course</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="teacher_id"/>
                            <field name="active"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="number_of_days"/>
                            <field name="time" widget="float_time"/>
                            <field name="room_id"/>
                            <field name="location_id"/>
                            <field name="available_seats"/>
                            <field name="target_gender"/>
                            <field name="deadline"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_location_list" model="ir.ui.view">
            <field name="name">location.list</field>
            <field name="model">location</field>
            <field name="arch" type="xml">
                <list string="Locations">
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
        </record>

        <record id="view_location_form" model="ir.ui.view">
    <field name="name">location.form</field>
    <field name="model">location</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="code"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

        <record id="view_room_list" model="ir.ui.view">
            <field name="name">room.list</field>
            <field name="model">room</field>
            <field name="arch" type="xml">
                <list string="Rooms">
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
        </record>

        <record id="view_room_form" model="ir.ui.view">
    <field name="name">room.form</field>
    <field name="model">room</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="code"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

        <record id="view_teacher_list" model="ir.ui.view">
            <field name="name">teacher.list</field>
            <field name="model">teacher</field>
            <field name="arch" type="xml">
                <list string="Teachers">
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
        </record>

        <record id="view_teacher_form" model="ir.ui.view">
            <field name="name">teacher.form</field>
            <field name="model">teacher</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>

                            <field name="user_id" string="Related User Account"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="registration_model_action" model="ir.actions.act_window">
            <field name="name">Registration</field>
            <field name="res_model">registration</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="course_model_action" model="ir.actions.act_window">
            <field name="name">Courses</field>
            <field name="res_model">course</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_course_search"/>
            <field name="context">{
                'search_default_all_course': 1
            }</field>
        </record>

        <record id="action_my_courses" model="ir.actions.act_window">
            <field name="name">My Courses</field>
            <field name="res_model">course</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('registration_ids.trainee_id.user_id', '=', uid)]</field> 
        </record>

        <record id="location_model_action" model="ir.actions.act_window">
            <field name="name">Locations</field>
            <field name="res_model">location</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="room_model_action" model="ir.actions.act_window">
            <field name="name">Rooms</field>
            <field name="res_model">room</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="teacher_model_action" model="ir.actions.act_window">
            <field name="name">Teachers</field>
            <field name="res_model">teacher</field>
            <field name="view_mode">list,form</field>
        </record>


        <menuitem id="main_model_menu_action" name="Activity One">
            <menuitem id="registration_model_menu_action" name="Registration" action="registration_model_action"/>
            <menuitem id="course_model_menu_action" name="Courses" action="course_model_action"/>
            <menuitem id="location_model_menu_action" name="Locations" action="location_model_action"/>
            <menuitem id="room_model_menu_action" name="Rooms" action="room_model_action"/>
            <menuitem id="teacher_model_menu_action" name="Teachers" action="teacher_model_action"/>
        </menuitem>

    </data>
</odoo>
