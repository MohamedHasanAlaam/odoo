<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_registration" model="ir.module.category">
        <field name="name">Registration System Access</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_registration_requester" model="res.groups">
        <field name="name">Requester</field>
        <field name="category_id" ref="module_category_registration"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_registration_teacher" model="res.groups">
        <field name="name">Teacher</field>
        <field name="category_id" ref="module_category_registration"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_registration_hr" model="res.groups">
        <field name="name">HR</field>
        <field name="category_id" ref="module_category_registration"/>
        <field name="implied_ids" eval="[(4, ref('group_registration_requester')), (4, ref('group_registration_teacher'))]"/>
    </record>
</odoo>
